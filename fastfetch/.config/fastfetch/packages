#!/bin/sh
# Prints the package counts of the host and of userland for fastfetch's Packages line: fastfetch's
# own module only sees the system it runs in.
db=/var/lib/pacman/local
# arkdep images keep the host's database in /var, bootc images in /usr/lib/sysimage
host=$db
[ -d "$host" ] || host=/usr/lib/sysimage/lib/pacman/local
count="find $db -mindepth 1 -maxdepth 1 -type d | wc -l"
box=$(podman exec userland sh -c "$count" 2>/dev/null)
echo "$(find "$host" -mindepth 1 -maxdepth 1 -type d | wc -l) (host)${box:+, $box (userland)}"
