# Hosts of one machine only (work servers...) go in ~/.ssh/config.d/, which is not in this repo
Include config.d/*

# The SSH keys live in gpg-agent (SSH_AUTH_SOCK in .zprofile), which asks for their passphrase on
# the terminal and display it was last pointed at: the ssh-agent protocol carries neither. Point it
# at this ssh's own (GPG_TTY from .zshrc, DISPLAY) before every connection: a dialog on the desktop,
# a prompt in the terminal itself in an SSH session to this machine. Pointing it from each new
# shell instead (.zshrc) left it on the terminal of an SSH session after that session closed, and
# every later ssh on the desktop failed ("agent refused operation"). Last in the file: a Match block
# lasts until the next Host or Match, and this one sets nothing
Match host * exec "gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1"
