# Hosts of one machine only (work servers...) go in ~/.ssh/config.d/, which is not in this repo
Include config.d/*

Host *
	# The SSH keys live in gpg-agent (SSH_AUTH_SOCK in .zprofile), which asks for their passphrase
	# on the terminal and display it was last pointed at: the ssh-agent protocol carries neither.
	# Point it at this ssh's own (GPG_TTY from .zshrc, DISPLAY) before every connection: a dialog on
	# the desktop, a prompt in the terminal itself in an SSH session to this machine.
	# KnownHostsCommand runs while ssh checks the host key, before it authenticates; it prints no
	# host key. Its program must be a literal absolute path (tokens and ${HOME} only expand in its
	# arguments), hence /bin/sh, there on the host and in the boxes. Not Match exec, which runs
	# through $SHELL: distrobox sets it to "zsh", without a path, in its boxes, and ssh refused it
	# ("Shell "zsh" is not executable"), which broke Ansible and git in userland. Not from each new
	# shell (.zshrc) either: that left the agent on the terminal of an SSH session after the session
	# closed ("agent refused operation")
	KnownHostsCommand /bin/sh -c "gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1"
