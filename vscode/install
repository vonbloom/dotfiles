#!/bin/bash

EXTENSIONS=(
    "ms-vscode-remote.remote-containers"
)

echo "Checking VS Code extensions..."
INSTALLED=$(code --list-extensions | tr '[:upper:]' '[:lower:]')

for ext in "${EXTENSIONS[@]}"; do
    ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
    if echo "$INSTALLED" | grep -q "^${ext_lower}$"; then
        echo "Already installed: $ext"
    else
        echo "Installing: $ext..."
        code --install-extension "$ext"
    fi
done

echo "Extensions are up to date!"

# The host's Secret Service (gnome-keyring, unlocked at login) for tokens and passwords: on sway
# VS Code does not detect it and falls back to its weak "basic" encryption. argv.json is written
# by VS Code itself (crash reporter id), so the key is added rather than the file stowed
ARGV=$HOME/.vscode/argv.json
if [[ -f $ARGV ]] && ! grep -q '"password-store"' "$ARGV"; then
    sed -i '0,/^{/s//{\n\t"password-store": "gnome-libsecret",/' "$ARGV"
    echo "argv.json: password-store gnome-libsecret (restart VS Code)"
fi
